<Page x:Class="UserAdmin.Views.MemberEditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:UserAdmin.Views"
      mc:Ignorable="d" 
      Title="Tag szerkesztése"
      Background="{StaticResource AccentBrush}">

    <Grid Margin="24">
        <StackPanel>
            <TextBlock x:Name="HeaderText" Text="Új tag" Style="{StaticResource TitleText}" FontSize="20"
                       HorizontalAlignment="Center" Margin="0,0,0,20"/>
            <TextBox x:Name="IdBox" Visibility="Collapsed"/>
            <TextBlock Text="Felhasználónév" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
                       Margin="0,0,0,4"/>
            <TextBox x:Name="UsernameBox"/>
            
            <TextBlock Text="Email" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
            Margin="0,0,0,4"/>
            <TextBox x:Name="EmailBox"/>

            <TextBlock x:Name="PasswordText" Text="Jelszó" FontSize="12" Foreground="{StaticResource MutedTextBrush}"
            Margin="0,0,0,4"/>
            <PasswordBox x:Name="PasswordBoxInput"/>

            <TextBlock x:Name="ErrorText" Style="{StaticResource ErrorText}" Visibility="Collapsed" Margin="0,0,0,8"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,12,0,0">
                <Button x:Name="CancelButton" Content="Mégse" Style="{StaticResource SecondaryButton}" Width="110"
                        Margin="0,0,10,0" Click="CancelButton_Click"/>
                <Button x:Name="SaveButton" Content="Mentés" Style="{StaticResource PrimaryButton}" Width="110"
                        Click="SaveButton_Click"/>

            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
